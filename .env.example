# Development server configuration. Never copy real secrets into source files.
NODE_ENV=development
PORT=3001
INVITE_CODE=ANT-LIFE-LOCAL
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173

# Optional locally; when omitted, the server uses .local/colony.json.
# In production, DATABASE_URL is required and should point to Neon PostgreSQL.
DATABASE_URL=

# Optional path when using local-file persistence.
LOCAL_SAVE_PATH=.local/colony.json
