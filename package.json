{
  "name": "ant-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent, private multiplayer ant-colony survival game for the browser.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config vite.config.ts --host 0.0.0.0 --port 5173",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist/server/src/index.js",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4173",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
